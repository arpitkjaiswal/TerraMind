    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.62.1",
    "typescript": "^5"
  }
